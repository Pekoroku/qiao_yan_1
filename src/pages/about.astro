---
import Layout from '../layouts/Layout.astro';
import {site,url,images} from '../lib/content';
import Icon from '../components/Icon.astro';
import ArtworkImage from '../components/ArtworkImage.astro';
---
<Layout title="关于艺术家"><section class="about-page wrap"><header class="page-heading"><div><p class="eyebrow">About / 关于艺术家</p><h1>The artist<span class="heading-dot">.</span></h1></div></header><div class="about-body">{site.portrait?<ArtworkImage image={images['artist-portrait'][0]} eager kind="display" sizes="(max-width: 760px) 88vw, 42vw"/>:<div class="name-panel"><span>Jiang</span><span>Qiao Yan</span></div>}<div class="prose"><h2>Jiang Qiao Yan</h2>{site.about.length?site.about.map(p=><p>{p}</p>):<p>{site.mode==='demo'?'艺术家简介与创作自述尚待确认。正式内容到齐后，将在这里呈现。':'艺术家资料整理中。'}</p>}{site.exhibitions.length>0&&<><h2>展览经历</h2><ul>{site.exhibitions.map(e=><li>{[e.year,e.title,e.venue].filter(Boolean).join(' · ')}</li>)}</ul></>}<a class="text-link" href={url('works/')}>浏览作品<Icon/></a></div></div></section></Layout>

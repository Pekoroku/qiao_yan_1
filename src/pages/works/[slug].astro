---
import {render} from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ArtworkImage from '../../components/ArtworkImage.astro';
import Icon from '../../components/Icon.astro';
import {artworks,images,url} from '../../lib/content';
export async function getStaticPaths(){const all=await artworks();return all.map((art,i)=>({params:{slug:art.data.slug},props:{art,prev:all[i-1],next:all[i+1],index:i,total:all.length}}));}
const {art,prev,next,index,total}=Astro.props;
const {Content}=await render(art);
const im=images[art.id][0];
const metadata=[['年份',art.data.year],['媒介',art.data.medium],['尺寸',art.data.dimensions],['系列',art.data.series]].filter(([,value])=>Boolean(value));
---
<Layout title={art.data.title} description={art.data.summary||`${art.data.title} · Jiang Qiao Yan 油画作品集`} image={art.data.isPlaceholder?undefined:im.fallback}>
  <article class="artwork-page wrap">
    <div class="detail-top"><a class="back-link" href={url('works/')}><Icon name="left"/>全部作品</a><span class="eyebrow">{String(index+1).padStart(2,'0')} / {total}</span></div>
    <div class="artwork-intro"><figure class="detail-figure"><div id="main-art-image"><ArtworkImage image={im} eager kind="display" sizes="(max-width: 760px) 88vw, 62vw"/></div><figcaption><button class="text-link" type="button" id="open-viewer" hidden>只看画作<Icon name="expand"/></button>{art.data.isPlaceholder&&<span>版式样本 · 非正式作品</span>}</figcaption></figure>
    <header class="artwork-info"><p class="eyebrow">Jiang Qiao Yan</p><h1>{art.data.title}</h1>{art.data.summary&&<p class="art-summary">{art.data.summary}</p>}{metadata.length>0&&<dl>{metadata.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>}</header></div>
    {art.body?.trim()&&<section class="story-section"><p class="eyebrow">Behind the painting / 创作记述</p><div class="prose"><Content/></div></section>}
    {images[art.id].length>1&&<section class="details-section"><h2>画中细节</h2><div class="detail-images">{images[art.id].slice(1).map(img=><figure><ArtworkImage image={img} kind="display" sizes="(max-width: 760px) 88vw, 42vw"/>{img.caption&&<figcaption>{img.caption}</figcaption>}</figure>)}</div></section>}
    <nav class="work-pagination" aria-label="作品之间导航"><div>{prev?<a href={url(`works/${prev.data.slug}/`)}><Icon name="left"/><span><small>上一件</small>{prev.data.title}</span></a>:<span class="boundary">已是第一件作品</span>}</div><a class="all-link" href={url('works/')}>全部作品</a><div>{next?<a href={url(`works/${next.data.slug}/`)}><span><small>下一件</small>{next.data.title}</span><Icon name="right"/></a>:<span class="boundary">已是最后一件作品</span>}</div></nav>
  </article>
  <dialog id="art-viewer" class="art-viewer" aria-label={`${art.data.title}，只看画作`}>
    <div class="viewer-toolbar"><span>{art.data.title}</span><div>{im.high&&<button type="button" id="load-high" data-src={url(im.high.src)} data-width={im.high.width} data-height={im.high.height}>加载高清细节（{(im.high.bytes/1000000).toFixed(1)} MB）</button>}<button type="button" id="close-viewer" aria-label="关闭看画模式"><Icon name="close"/><span>关闭</span></button></div></div>
    <div id="viewer-canvas" class="viewer-canvas"></div><p id="viewer-status" role="status" aria-live="polite"></p>
  </dialog>
</Layout>

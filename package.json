{
  "name": "jiang-qiao-yan-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "dev": "node scripts/prepare.mjs && node scripts/publish-images.mjs --dev && astro dev --host 127.0.0.1",
    "check": "node scripts/prepare.mjs && astro check",
    "build": "node scripts/prepare.mjs && node scripts/clean.mjs && astro build && node scripts/publish-images.mjs && node scripts/audit.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "prepare:content": "node scripts/prepare.mjs",
    "artwork:new": "node scripts/artwork.mjs new",
    "artwork:image": "node scripts/artwork.mjs image",
    "test": "node --test tests/content.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:lifecycle": "node tests/lifecycle.mjs"
  },
  "dependencies": {"astro": "7.3.3", "gray-matter": "4.0.3", "sharp": "0.34.5"},
  "devDependencies": {"@astrojs/check": "0.9.10", "typescript": "5.9.3", "playwright": "1.58.2"}
}
